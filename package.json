    "@types/html-webpack-plugin": "^3.2.9",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.6",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.2.19",
    "@types/react-window": "^1.8.8",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.36.0",
    "@typescript-eslint/parser": "^8.36.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.0",
